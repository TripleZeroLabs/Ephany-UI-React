# .env.example
# Example environment configuration for Ephany UI

# Where /api should proxy to in development.
# Developers should update this to match their own Ephany Framework backend.
VITE_PROXY_TARGET=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000/api

# There is no API key here on purpose. Vite inlines VITE_* values into the
# built JS bundle, so anything set here is readable by every visitor. The app
# authenticates as a user instead: log in, and it stores a DRF token.
# API keys are for clients that can keep a secret - the Revit plugin, CLI
# scripts, the Smartsheet sync commands.

# Use mock data instead of hitting a real backend API.
# Set to 'true' for offline development.
VITE_USE_MOCK_DATA=false
